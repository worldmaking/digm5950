void mainImage(out vec4 fragColor, in vec2 fragCoord) {
  vec2 uv = fragCoord / iResolution.xy;
  // Particle Control
  vec4 A = texture(iChannel0, uv);
  // Particle Traces
  vec4 B = texture(iChannel1, uv);
  // Ising Automata
  vec4 C = texture(iChannel2, uv);

  // Output to screen
  // Multiplication by 0.15 of the automata channel gives nice transparency
  // and give room for particle to show its movement
  fragColor = 0.15 * C * B;
  // Another variant with stronger colors
  // fragColor = 0.15*C*0.15*C*B;
  // To check how the probability field changes
  // fragColor = C;
}